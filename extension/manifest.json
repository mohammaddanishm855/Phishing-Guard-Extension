
{
  "manifest_version": 3,
  "name": "Phishing Guard - Browser Security",
  "version": "1.2.0",
  "description": "AI-powered browser security and phishing detection.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Phishing Guard"
  }
}
